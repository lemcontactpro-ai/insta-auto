  "grammaire": [
    {"titre": "이/가 · 은/는", "regle": "이/가 marque le sujet, 은/는 marque le thème ou le contraste.", "exemple_natif": "저는 학생이에요", "exemple_lecture": "jeoneun haksaeng-ieyo", "exemple_fr": "Moi, je suis étudiant.", "surligne_natif": "는", "surligne_fr": "Moi", "astuce": "은/는 sert souvent à se présenter en début de phrase."},
    {"titre": "을/를", "regle": "Marque le complément d'objet direct : 을 après consonne, 를 après voyelle.", "exemple_natif": "책을 읽어요", "exemple_lecture": "chaegeul ilgeoyo", "exemple_fr": "Je lis un livre.", "surligne_natif": "을", "surligne_fr": "livre", "astuce": "책(consonne)+을, 커피(voyelle)+를 : regarde juste la dernière lettre."},
    {"titre": "에 · 에서", "regle": "에 = destination ou position fixe, 에서 = lieu où se déroule une action.", "exemple_natif": "카페에서 만나요", "exemple_lecture": "kape-eseo manayo", "exemple_fr": "On se voit au café.", "surligne_natif": "에서", "surligne_fr": "café", "astuce": "학교에 가요 (destination) mais 학교에서 공부해요 (action)."},
    {"titre": "이에요 · 예요", "regle": "Forme polie du verbe être : 이에요 après consonne, 예요 après voyelle.", "exemple_natif": "저는 가수예요", "exemple_lecture": "jeoneun gasu-yeyo", "exemple_fr": "Je suis chanteur.", "surligne_natif": "예요", "surligne_fr": "chanteur", "astuce": "가수(voyelle)+예요, 학생(consonne)+이에요."},
    {"titre": "아요 · 어요", "regle": "Présent poli : radical + 아요 (voyelle ㅏ/ㅗ) ou + 어요 (autres voyelles).", "exemple_natif": "매일 먹어요", "exemple_lecture": "maeil meogeoyo", "exemple_fr": "Je mange tous les jours.", "surligne_natif": "먹어요", "surligne_fr": "mange", "astuce": "먹다 → 어요 (ㅓ), 가다 → 아요 (ㅏ) : tout dépend de la dernière voyelle du radical."},
    {"titre": "았어요 · 었어요", "regle": "Passé poli : on insère 았 ou 었 avant 어요, selon la même règle de voyelle.", "exemple_natif": "어제 만났어요", "exemple_lecture": "eoje mannasseoyo", "exemple_fr": "On s'est vus hier.", "surligne_natif": "만났어요", "surligne_fr": "vus", "astuce": "만나다 → 만났어요 : le radical garde sa voyelle ㅏ."},
    {"titre": "안 + 동사", "regle": "안 placé avant le verbe forme la négation simple : « ne pas ».", "exemple_natif": "안 바빠요", "exemple_lecture": "an bappayo", "exemple_fr": "Je ne suis pas occupé.", "surligne_natif": "안", "surligne_fr": "ne pas", "astuce": "Pour les verbes en 하다, 안 se place avant 하다 : 공부 안 해요."},
    {"titre": "못 + 동사", "regle": "못 placé avant le verbe exprime l'incapacité : « ne pas pouvoir ».", "exemple_natif": "저는 못 가요", "exemple_lecture": "jeoneun mot gayo", "exemple_fr": "Je ne peux pas y aller.", "surligne_natif": "못", "surligne_fr": "ne peux pas", "astuce": "안 = un choix, 못 = une incapacité réelle."},
    {"titre": "(으)ㄹ 거예요", "regle": "Exprime le futur ou une intention : radical + (으)ㄹ 거예요.", "exemple_natif": "내일 갈 거예요", "exemple_lecture": "naeil gal geoyeyo", "exemple_fr": "J'irai demain.", "surligne_natif": "갈 거예요", "surligne_fr": "J'irai", "astuce": "가다 → 갈 거예요 : radical vocalique, on ajoute juste ㄹ 거예요."},
    {"titre": "고 싶어요", "regle": "Radical + 고 싶어요 exprime le souhait : « avoir envie de ».", "exemple_natif": "한국에 가고 싶어요", "exemple_lecture": "hanguge gago sipeoyo", "exemple_fr": "J'ai envie d'aller en Corée.", "surligne_natif": "싶어요", "surligne_fr": "envie", "astuce": "Toujours 고 싶어요, quel que soit le verbe : très simple à retenir."},
