# Secrets pour GitHub Actions
# À configurer dans : Settings → Secrets and variables → Actions
# Crée des secrets nommés exactement comme ci-dessous

# Instagram / Meta
IG_USER_ID_ARABE=123456789
IG_TOKEN_ARABE=IGQVJfZ...
# Attention : le jeton expire tous les 60 jours
# À renouveler tous les 2 mois

# Cloudinary (hébergement des images)
CLOUDINARY_CLOUD_NAME=ma_cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdef...

# Pour d'autres niches (exemple)
# IG_USER_ID_JAPONAIS=987654321
# IG_TOKEN_JAPONAIS=IGQVJfZ...
