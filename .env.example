# Secrets pour GitHub Actions
# À configurer dans : Settings → Secrets and variables → Actions
# Crée des secrets nommés exactement comme ci-dessous

# Instagram / Meta
IG_USER_ID_ARABE=123456789
IG_TOKEN_ARABE=IGQVJfZ...
# Le jeton expire tous les 60 jours, mais c'est renouvelé automatiquement
# par .github/workflows/renouveler_token.yml — voir les 3 secrets ci-dessous
# et la section 6 de GUIDE.md.

# Renouvellement automatique du jeton (une seule fois pour tout le dépôt,
# partagé entre toutes les niches)
META_APP_ID=123456789
META_APP_SECRET=abcdef...
# PAT GitHub "fine-grained", limité à ce dépôt, permission Secrets: read/write
GH_PAT_SECRETS=github_pat_...

# Cloudinary (hébergement des images)
CLOUDINARY_CLOUD_NAME=ma_cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdef...

# Pour d'autres niches (exemple)
# IG_USER_ID_JAPONAIS=987654321
# IG_TOKEN_JAPONAIS=IGQVJfZ...
